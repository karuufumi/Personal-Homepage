---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { photoAlbums } from "@/data/photoAlbums";

const albums = [...photoAlbums].sort(
  (first, second) => new Date(second.date).getTime() - new Date(first.date).getTime()
);

const dateFormat = new Intl.DateTimeFormat("en", {
  month: "long",
  year: "numeric",
});
---

<Layout title="Photos | Nguyễn Tiến Khang" description="A chronological collection of photography by Nguyễn Tiến Khang.">
  <Header />
  <main id="main-content" class="app-layout py-12">
    <p class="text-accent text-sm font-semibold tracking-widest uppercase">Photography archive</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Photos</h1>
    <p class="mt-4 max-w-2xl text-lg">A growing collection of moments, places, and details captured over time. Albums are arranged from newest to oldest.</p>

    {
      albums.length > 0 ? (
        <div class="mt-12 space-y-10">
          {albums.map(album => {
            const cover = album.photos[0];
            return (
              <article class="border-border border-b pb-10">
                {cover && <a href={`/photos/${album.slug}`} class="mb-5 block overflow-hidden border"><img src={cover.src} alt={cover.alt} class="aspect-[16/8] w-full object-cover transition-transform duration-300 hover:scale-[1.02]" loading="lazy" /></a>}
                <p class="text-accent text-sm font-medium">{dateFormat.format(new Date(album.date))} · {album.photos.length} photo{album.photos.length === 1 ? "" : "s"}</p>
                <h2 class="mt-2 text-2xl font-semibold"><a class="hover:text-accent underline decoration-dashed underline-offset-4" href={`/photos/${album.slug}`}>{album.title}</a></h2>
                <p class="mt-3 max-w-3xl">{album.description}</p>
              </article>
            );
          })}
        </div>
      ) : (
        <section class="border-border mt-12 border-y py-10">
          <h2 class="text-2xl font-semibold">The archive is beginning</h2>
          <p class="mt-3 max-w-2xl">Photo albums will appear here in chronological order, each with its own description and gallery.</p>
        </section>
      )
    }
  </main>
  <Footer />
</Layout>
