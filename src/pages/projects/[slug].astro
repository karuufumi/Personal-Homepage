---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/projects";

export function getStaticPaths() {
  return projects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} | Nguyễn Tiến Khang`} description={project.description}>
  <Header />
  <main id="main-content" class="app-layout py-12">
    <a href="/projects" class="text-accent hover:underline">← All projects</a>
    <p class="text-accent mt-8 text-sm font-semibold tracking-widest uppercase">{project.status}</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">{project.title}</h1>
    <p class="mt-5 max-w-3xl text-lg">{project.description}</p>
    <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
      {project.tags.map(tag => <li class="border-border rounded border px-2 py-1 text-sm">{tag}</li>)}
    </ul>
    <div class="mt-12 max-w-3xl space-y-10">
      <section><h2 class="text-2xl font-semibold">The problem</h2><p class="mt-3">{project.problem}</p></section>
      <section><h2 class="text-2xl font-semibold">Key areas</h2><ul class="mt-3 list-disc space-y-2 ps-6">{project.features.map(feature => <li>{feature}</li>)}</ul></section>
      <section><h2 class="text-2xl font-semibold">What I learned</h2><p class="mt-3">{project.learned}</p></section>
    </div>
  </main>
  <Footer />
</Layout>
