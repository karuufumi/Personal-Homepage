---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { projects } from "@/data/projects";
---

<Layout title="Projects | Nguyễn Tiến Khang" description="Selected backend, cloud, security, and systems projects by Nguyễn Tiến Khang.">
  <Header />
  <main id="main-content" class="app-layout py-12">
    <p class="text-accent text-sm font-semibold tracking-widest uppercase">Selected work</p>
    <h1 class="mt-3 text-4xl font-bold sm:text-5xl">Projects with a clear question behind them.</h1>
    <p class="mt-4 max-w-2xl text-lg">Backend experiments, platform builds, and systems research in progress.</p>
    <div class="mt-12 space-y-10">
      {projects.map(project => (
        <article class="border-border border-b pb-10">
          <p class="text-accent text-sm font-medium">{project.status}</p>
          <h2 class="mt-2 text-2xl font-semibold"><a class="hover:text-accent underline decoration-dashed underline-offset-4" href={`/projects/${project.slug}`}>{project.title}</a></h2>
          <p class="mt-3 max-w-3xl">{project.description}</p>
          <ul class="mt-4 flex flex-wrap gap-2" aria-label={`${project.title} technologies`}>
            {project.tags.map(tag => <li class="border-border rounded border px-2 py-1 text-sm">{tag}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
